{
	"name": "DelimitedText2",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ADLS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"file": {
				"type": "string"
			},
			"folder": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().file",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('bronze data','/',dataset().folder)",
					"type": "Expression"
				},
				"fileSystem": "sales"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "CustomerID",
				"type": "String"
			},
			{
				"name": "FirstName",
				"type": "String"
			},
			{
				"name": "LastName",
				"type": "String"
			},
			{
				"name": "City",
				"type": "String"
			},
			{
				"name": "Email",
				"type": "String"
			},
			{
				"name": "ModifiedDate",
				"type": "String"
			}
		]
	}
}