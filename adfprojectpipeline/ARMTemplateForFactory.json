			"metadata": "Data Factory name",
			"defaultValue": "adfprojectpipeline"
		},
		"ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS'"
		},
		"ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://salesstorageproject.dfs.core.windows.net/"
		},
		"AzureDatabricks_new_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0410-184717-ibktux7e"
		},
		"Github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"SQL Database for Copy_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dnpserver123.database.windows.net"
		},
		"SQL Database for Copy_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dnpdatabase"
		},
