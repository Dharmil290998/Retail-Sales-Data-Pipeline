			"defaultValue": "dnpdatabase"
		},
		"SQL Database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dnpserver"
		},
		"keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://salesproject.vault.azure.net/"
